+// ACPX persisted sessions enforce a snake_case `session_options.env` schema.
+// Our Paperclip env keys are UPPER_SNAKE (`PAPERCLIP_*`, `ANTHROPIC_*`, etc.),
+// so the loader/store round-trip triggers a "Persisted key policy violation
+// (expected snake_case keys)" error on every resume. Normalize the keys here
+// when we hand the env to the ACPX session-options plumbing. The process-env
+// the agent actually executes under (and `buildPrompt`) keeps the original
+// UPPER_SNAKE keys — we only rewrite the snapshot fed into the ACPX store.
+export function toAcpxSessionEnv(env: Record<string, string>): Record<string, string> {
+  const normalized: Record<string, string> = {};
+  for (const [key, value] of Object.entries(env)) {
+    normalized[key.toLowerCase()] = value;
+  }
+  return normalized;
+}
