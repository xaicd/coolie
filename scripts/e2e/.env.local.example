# Copy to .env.local (gitignored) and fill in. Never commit real credentials.
#
# The board under test. Prod defaults to https://www.xrobinai.cn/XROA; point
# this at any deployment (staging / local throwaway) to reuse the same suite.
E2E_BASE_URL=https://www.xrobinai.cn/XROA

# A board account with access to the target company.
E2E_EMAIL=
E2E_PASSWORD=

# Optional: pick a specific company instead of the first accessible one.
# Accepts the company name or its issue prefix (case-insensitive).
#
# Prefer the real board company for Web coverage (wave135 convention: Web tests
# run against `xrobinai` / prefix XROA). If left unset, the suite takes the first
# accessible company, which on the boss account is a leftover `prod-smoke-*` org.
# E2E_COMPANY=XROA

# Optional: agent used by the task-assignment spec (default core-swe-agent).
# E2E_AGENT=core-swe-agent

# Optional knobs.
# E2E_HEADLESS=false
# E2E_RETRIES=1
