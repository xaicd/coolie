{
  "name": "@paperclipai/agents",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./role-templates": "./role-templates/index.ts",
    "./role-templates/*": "./role-templates/*.ts",
    "./role-templates/templates/*": "./role-templates/templates/*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./role-templates": "./dist/role-templates/index.js",
      "./role-templates/*": "./dist/role-templates/*.js",
      "./role-templates/templates/*": "./dist/role-templates/templates/*"
    },
    "main": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@paperclipai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
