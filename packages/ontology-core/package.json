{
  "name": "@paperclipai/ontology-core",
  "version": "0.1.0",
  "type": "module",
  "description": "The ontology's host-free core: schema, facts, mapping and query services over the ontology tables.",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./*.js": "./dist/*.js",
      "./*": "./dist/*.js"
    },
    "main": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
