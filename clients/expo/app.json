{
  "expo": {
    "name": "Coolie工坊",
    "slug": "coolie",
    "scheme": [
      "coolie",
      "coolieweb"
    ],
    "version": "0.6.30",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090A"
    },
    "newArchEnabled": true,
    "updates": {
      "url": "https://xrobinai.cn/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cn.xrobinai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Coolie uses the microphone to dispatch tasks by voice.",
        "NSLocationWhenInUseUsageDescription": "Coolie uses your location to tag where you are when dispatching tasks.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cloud.coolie.app",
      "versionCode": 630,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090A"
      },
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-av",
      "expo-secure-store",
      "expo-updates",
      "expo-task-manager",
      "expo-background-fetch",
      "expo-location",
      "expo-notifications",
      "./plugins/withLocalCleartextAllowlist"
    ],
    "extra": {
      "deepLinks": {
        "scheme": "coolie",
        "routes": {
          "workspace": "coolie://workspace",
          "chatBuild": "coolie://chat/build",
          "chatBuildWithTitle": "coolie://chat/build/<标题>"
        },
        "coolieWeb": "coolieweb://"
      }
    }
  }
}
