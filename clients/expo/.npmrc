# Metro resolves modules by walking a flat node_modules and does not follow
# pnpm's symlinked store layout — with the default linker the bundle fails on
# `@babel/runtime/helpers/interopRequireDefault` because it lives under
# node_modules/.pnpm only. Expo's own guidance for pnpm is a hoisted install.
#
# Local to this package, so the rest of the repo keeps pnpm's strict default and
# this app still installs standalone (see .gitignore / README).
node-linker=hoisted
