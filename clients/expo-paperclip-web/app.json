{
  "expo": {
    "name": "Coolie Web",
    "slug": "coolie-paperclip-web",
    "scheme": "coolieweb",
    "version": "0.6.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "url": "https://xrobinai.cn/ota/paperclip-web/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.coolie.app.web"
    },
    "android": {
      "package": "cloud.coolie.app.web",
      "versionCode": 4,
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-updates"
    ],
    "extra": {
      "paperclipWeb": {
        "url": "https://www.xrobinai.cn/XROA",
        "cockpitDeepLink": "coolie://"
      }
    }
  }
}
