{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "一、流量、网关与端点健康度 (QPS & Latency)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "网关 QPS 与 2xx/4xx/5xx 状态分布",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "端点 P90 / P99 延迟趋势 (SLO 守望)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 延迟"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P90 延迟"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "二、数据库与核心中间件健康度 (DB & Storage)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "title": "Postgres / MySQL 连接池水位与活跃连接",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{state=\"active\"}) / clamp_min(max(pg_settings_max_connections), 1)",
          "legendFormat": "PG 活跃连接率"
        },
        {
          "expr": "mysql_global_status_threads_connected / clamp_min(mysql_global_variables_max_connections, 1)",
          "legendFormat": "MySQL 活跃连接率"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "title": "Redis 命中率与慢查询次数",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))",
          "legendFormat": "Redis 缓存命中率"
        },
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "慢查询 QPS"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 7,
      "title": "三、核心业务信号与交易成功率 (Business Signals)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 8,
      "title": "微信支付 / 下单履约成功率 (SLO ≥ 99.5%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cls_order_created_total{result=\"success\"}[5m])) / clamp_min(sum(rate(cls_order_created_total[5m])), 0.001)",
          "legendFormat": "下单成功率"
        },
        {
          "expr": "sum(rate(cls_pay_callback_total{status=\"success\"}[5m])) / clamp_min(sum(rate(cls_pay_callback_total[5m])), 0.001)",
          "legendFormat": "支付回调验签率"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 9,
      "title": "多租户行级隔离拦截与安全验签异常",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(cls_tenant_isolation_violation_total[5m]))",
          "legendFormat": "租户隔离越权阻断: {{tenant_id}}"
        },
        {
          "expr": "sum(rate(cls_sm4_decrypt_failure_total[5m]))",
          "legendFormat": "SM4 字段解密失败"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 10,
      "title": "四、备份与容灾监控 (Postgres WAL & Disaster Recovery)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 11,
      "title": "Postgres WAL 上次成功距今时间 (RPO ≤ 5m 告警)",
      "type": "stat",
      "targets": [
        {
          "expr": "time() - coolie_backup_last_success_timestamp_seconds{job=\"postgres-wal\"}",
          "legendFormat": "备份陈旧时间"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 12,
      "title": "最新备份产物字节大小与耗时",
      "type": "timeseries",
      "targets": [
        {
          "expr": "coolie_backup_last_size_bytes{job=\"postgres-wal\"}",
          "legendFormat": "备份产物大小"
        },
        {
          "expr": "coolie_backup_last_duration_seconds{job=\"postgres-wal\"}",
          "legendFormat": "备份耗时 (秒)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["coolie", "production", "slo", "backup"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "Coolie 生产商用中台大盘 (CLS Production Overview)",
  "uid": "coolie-prod-overview",
  "version": 1
}
